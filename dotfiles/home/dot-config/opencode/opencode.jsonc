{
  "$schema": "https://opencode.ai/config.json",

  "autoupdate": "notify",

  "permission": {
    "*": "allow",

    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      ".env.example": "allow"
    },

    "bash": {
      "*": "allow",

      "rm *": "deny",
      "sudo *": "deny",

      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push --mirror*": "deny",
      "git commit*-n*": "deny",
      "git commit*--no-verify*": "deny",
      "git rebase*": "ask",
      "git reset --hard*": "ask",

      "make MODE=dbg": "allow",
      "make MODE=rel": "allow",
      "make MODE=cov": "allow",
      "make test*": "allow",
      "make -C test*": "allow",
      "make clean*": "allow",
      "echo *": "allow"
    },

    "edit": {
      "*": "allow",
      "opencode.jsonc": "ask",
      "opencode.json": "ask",
      "tui.json": "ask",
      ".opencode/**": "ask"
    },

    "external_directory": "ask",
    "doom_loop": "ask"
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },

  "watcher": {
    "ignore": ["node_modules/**", "dist/**", "build/**", ".git/**", "*.o", "*.obj", "target/**"]
  },

  "agent": {
    "build": {
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },

    "plan": {
      "mode": "primary",
      "permission": {
        "edit": "ask",
        "bash": "ask"
      }
    },

    "code-review": {
      "description": "Read-only whole-codebase analyzer. Inspects code and returns a large specific list of what to change. The main model reads the lists and applies the edits itself. Run several at once on different angles such as code style, optimization, and allocator usage.",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "ls *": "allow",
          "find *": "allow",
          "make *": "allow"
        },
        "webfetch": "allow",
        "websearch": "allow"
      }
    },

    "explore": {
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  }
}
