{
    "outline_panel": {
        "dock": "left"
    },
    "collaboration_panel": {
        "dock": "left"
    },
    "git_panel": {
        "dock": "left"
    },
    "agent_servers": {
        "claude-acp": {
            "type": "registry",
        },
    },
    "edit_predictions": {
        "provider": "none",
    },
    "buffer_line_height": "standard",
    "hide_mouse": "never",

    "base_keymap": "VSCode",

    "git": {
        "inline_blame": {
            "enabled": false,
        },
    },

    "vim_mode": true,
    "vim": {
        "cursor_shape": {
            "insert": "bar",
            "replace": "hollow",
            "visual": "underline",
        },
        "use_smartcase_find": true,
    },

    "minimap": {
        "show": "never",
    },
    "cursor_shape": "bar",

    "icon_theme": {
        "mode": "system",
        "light": "Zed (Default)",
        "dark": "Zed (Default)",
    },

    "ui_font_family": "Inter",
    "ui_font_size": 16.0,

    "buffer_font_family": "JetBrains Mono",
    "buffer_font_size": 16.0,

    "theme": {
        "mode": "system",
        "light": "One Light",
        "dark": "Gruvbox Dark",
    },

    "agent_ui_font_size": 16.0,

    "session": {
        "trust_all_worktrees": true,
    },
    "project_panel": {
        "dock": "left",
        "auto_fold_dirs": false,
    },
    "preview_tabs": {
        "enabled": false,
    },
    "tab_bar": {
        "show": false,
    },
    "use_smartcase_search": true,
    "vertical_scroll_margin": 5.0,
    "max_tabs": 16,
    "autosave": {
        "after_delay": {
            "milliseconds": 1000,
        },
    },
    "tab_size": 4,
    "colorize_brackets": true,
    "lsp_document_colors": "background",
    "buffer_font_weight": 420.0,
    "show_completions_on_input": true,
    "show_whitespaces": "all",
    "ensure_final_newline_on_save": false,
    "remove_trailing_whitespace_on_save": false,
    "indent_guides": {
        "enabled": false,
    },
    "soft_wrap": "editor_width",
    "scroll_beyond_last_line": "one_page",
    "agent": {
        "dock": "right",
        "default_model": {
            "provider": "openrouter",
            "model": "openai/gpt-5-codex",
        },
    },
    "telemetry": {
        "metrics": false,
        "diagnostics": false,
    },
    "terminal": {
        "shell": "system",
        "font_family": "JetBrains Mono",
    },
    "auto_install_extensions": {
        "wakatime": true,
    },
    "file_types": {
        "Shell Script": ["kosh", "shit"],
    },
    "languages": {
        "Shell Script": {
            "language_servers": ["kosh", "..."],
            "formatter": {
                "language_server": {
                    "name": "kosh",
                },
            },
        },
    },
}
