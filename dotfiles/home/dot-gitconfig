[safe]
    directory = *
[pull]
    rebase = true
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[init]
    defaultBranch = master
[include]
    path = .gitpager
[include]
    path = .gituser
[includeIf "gitdir:~/Work/**"]
    path = .gitwork
