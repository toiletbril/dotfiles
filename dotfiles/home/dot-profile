export CC="clang"
export CXX="clang++"

if [ "$(uname -s)" = Linux ]; then
  export LD="mold"
fi

export CCACHE_DIR="$HOME/.ccache"

if [ -d /usr/lib/ccache/bin ]; then
  export PATH="/usr/lib/ccache/bin:$PATH"
fi

export PATH="$PATH:$HOME/.local/bin:"

export EDITOR="nvim"
export BROWSER="zen"

export WINEDEBUG="-all"
export LESS="-+X -R"

# external components!!!
export EXTERNAL_DIR="$HOME/External"

export COSMO_DIR="$EXTERNAL_DIR/cosmo/bin"
export PATH="$PATH:$COSMO_DIR"

export BUN_INSTALL="$HOME/.bun"
export BUN_DIR="$BUN_INSTALL"
export PATH="$PATH:$BUN_DIR/bin"

export GOPATH="$HOME/.go"
export PATH="$PATH:$GOPATH/bin"

export ANDROID_HOME="$EXTERNAL_DIR/android-sdk"
export PATH="$PATH:$ANDROID_HOME/platform-tools"
export PATH="$PATH:$ANDROID_HOME/cmdline-tools/latest/bin"

export GCLOUD_HOME="$EXTERNAL_DIR/google-cloud-sdk"
export PATH="$PATH:$GCLOUD_HOME/bin"

export ANDROID_STUDIO="$EXTERNAL_DIR/android-studio"
export PATH="$PATH:$ANDROID_STUDIO/bin"

export PATH="$PATH:$HOME/.claude/local"

export PWSH_DIR="$EXTERNAL_DIR/powershell-bin"
export PATH="$PATH:$PWSH_DIR"

if command -v brew >/dev/null 2>&1; then
  BREW_EXECUTABLE="$(command -v brew)"
elif [ -x /opt/homebrew/bin/brew ]; then
  BREW_EXECUTABLE=/opt/homebrew/bin/brew
elif [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
  BREW_EXECUTABLE=/home/linuxbrew/.linuxbrew/bin/brew
fi

if [ -n "${BREW_EXECUTABLE:-}" ]; then
  eval "$("$BREW_EXECUTABLE" shellenv sh)"
  unset BREW_EXECUTABLE
fi

test -f "$HOME/.cargo/env" && . "$HOME/.cargo/env"

case ${BASH:-} in
  bash|*/bash)
    case ${BASH_VERSION:-} in
      [4-9]*|[1-9][0-9]*) BASH_SDKMAN_FILE="$HOME/.sdkman/bin/sdkman-init.sh" ;;
      *) BASH_SDKMAN_FILE= ;;
    esac

    for BASH_STARTUP_FILE in \
      "$BASH_SDKMAN_FILE" \
      "${GHOSTTY_RESOURCES_DIR:+$GHOSTTY_RESOURCES_DIR/shell-integration/bash/ghostty.bash}" \
      "${HOMEBREW_PREFIX:+$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh}"; do
      [ -r "$BASH_STARTUP_FILE" ] || continue

      BASH_STARTUP_HAD_NOUNSET=
      case $- in
        *u*) BASH_STARTUP_HAD_NOUNSET=1; set +u ;;
      esac

      if . "$BASH_STARTUP_FILE"; then :; else :; fi

      if [ -n "$BASH_STARTUP_HAD_NOUNSET" ]; then
        set -u
      fi
    done

    unset BASH_SDKMAN_FILE BASH_STARTUP_FILE BASH_STARTUP_HAD_NOUNSET
    ;;
esac

alias ls="lsd --group-directories-first --icon-theme=fancy -AF"
alias ll="lsd --group-directories-first --icon-theme=fancy -lAhXZF"
alias t="tailscale"

if [ "$(uname -s)" = Darwin ]; then
  alias less=moor
  alias nproc="sysctl -n hw.logicalcpu"
else
  alias less=moar
fi

export PATH="/usr/local/bin:$PATH"
export PATH
